<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch splash. A flat fill in the app's own surface colour, which resolves per
  light/dark via res/values-night/colors.xml.

  It was `@android:color/white` here and `?android:colorBackground` in the v21
  copy: the first flashed white before a dark-themed app, and the second deferred
  to the platform rather than to the app's own palette. Both are now the same
  resource, so the two files cannot drift.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
