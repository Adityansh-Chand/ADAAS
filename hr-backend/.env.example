PORT=3000
API_KEY=
MONGODB_URI=
BASE_URL=http://localhost:3000

# Optional LLM. With LLM_PROVIDER unset, policy answers come straight from the
# knowledge base -- which is the mode this repository is meant to be reviewed in.
# Supported providers: gemini, openai, anthropic. LLM_BASE_URL lets `openai`
# point at any OpenAI-compatible endpoint (Ollama, vLLM, OpenRouter, ...).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=8000
