PORT=3000
API_KEY=
MONGODB_URI=
BASE_URL=http://localhost:3000

# Policy retrieval: lexical | dense | hybrid. Default lexical.
#
# Measured on paraphrased questions (npm run eval, Set B report half):
#   lexical  top-1 0.1111   recall@5 0.1111   15 of 18 return nothing
#   dense    top-1 0.6111   recall@5 0.9444    0 of 18 return nothing
#   hybrid   top-1 0.6111   recall@5 0.9444   no better than dense alone
#
# dense and hybrid embed the query at request time, which needs the optional
# @huggingface/transformers devDependency. It is absent from production images
# (npm ci --omit=dev) because its transitive advisories have no fix available,
# so those modes fall back to lexical there and /health reports the degradation.
RETRIEVAL_MODE=

# Where the sentence-transformer weights are cached (~87 MB).
MODEL_CACHE_DIR=

# Optional LLM. With LLM_PROVIDER unset, policy answers come straight from the
# retrieved policy text -- which is the mode this repository is meant to be
# reviewed in. Supported: gemini, openai, anthropic. LLM_BASE_URL lets `openai`
# point at any OpenAI-compatible endpoint (Ollama, vLLM, OpenRouter, ...).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Where the models run
# ---------------------------------------------------------------------------
#
# Set this and the API stops loading models in-process and calls model-service/
# over HTTP instead. That is what makes RETRIEVAL_MODE=dense or =reranked usable
# in a built image: the API installs with --omit=dev and does not contain
# @huggingface/transformers at all, so the advisory-bearing package lives in one
# container that holds no HR data.
#
# There is deliberately NO fallback. With this set and the service unreachable,
# retrieval fails rather than quietly using a local model -- two sources
# substituting for each other silently is how a deployment serves vectors from a
# model it is not reporting. /health says which source is live.
MODEL_SERVICE_URL=
MODEL_SERVICE_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Authorization and identity
# ---------------------------------------------------------------------------
#
# Two separate things, and the distinction matters.
#
# SESSION_SECRET turns on per-employee SCOPING: every employee-facing route
# checks the request's employee_id against the caller's token, so 1001 cannot
# read 1002's balance by editing a query string. With it unset, nothing is
# enforced and /health reports authorization: none.
#
# It does NOT establish who the caller is. POST /session mints a token for any
# employee id it is asked for, because there is nothing here to authenticate
# against. It is the seam an identity provider replaces.
SESSION_SECRET=
SESSION_TTL_SECONDS=43200

# OIDC_ISSUER and OIDC_AUDIENCE are the other half: with both set, the service
# accepts an ID token from that provider and verifies it properly -- RS256 over
# the published JWKS with the algorithm pinned (not read from the token), key
# selection by kid, and iss/aud/exp/nbf all checked.
#
# Both are required. An issuer with no audience check is not a working verifier:
# it would accept a token minted for a different application at the same
# provider.
OIDC_ISSUER=
OIDC_AUDIENCE=

# Which claim carries the employee id. Mapping a directory identity onto an HR
# employee number is a deployment concern with no correct universal answer, so it
# is a setting rather than a guess. A token with nothing in this claim is
# refused rather than defaulted.
OIDC_EMPLOYEE_CLAIM=sub

# Which claim carries the role, if the provider sends one. An unrecognised value
# becomes `employee`, never `approver` -- defaulting upward would let any
# authenticated person act for anyone else.
OIDC_ROLE_CLAIM=adaas_role
OIDC_CLOCK_SKEW_SECONDS=60

# ---------------------------------------------------------------------------
# Notification delivery
# ---------------------------------------------------------------------------
#
# A decision is always recorded and stored. These control whether anyone is told.
# Delivery can never fail a decision -- the approval has already moved a balance --
# so failures are counted in /metrics rather than rolled back.
#
# Where notifications are persisted. They are written through to a file so a
# restart with no MONGODB_URI does not lose every decision anyone was told about.
NOTIFICATIONS_PATH=

# An outbound webhook: hands the notification to something that knows how to
# reach a person.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TIMEOUT_MS=2000

# Email. NOTIFY_EMAIL_TO is a single mailbox -- an HR inbox -- because this
# service has no directory, and deriving an address from an employee id would
# silently mail the wrong person.
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); leave false and STARTTLS is attempted on a
# plaintext port. If STARTTLS is declined and SMTP_USER is set, the send FAILS --
# credentials are never put on an unencrypted connection.
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Secrets from files
# ---------------------------------------------------------------------------
#
# Every secret above can instead be read from a file, by setting <NAME>_FILE to a
# path. This is the convention Docker secrets and Kubernetes secret volumes use,
# and the reason to prefer it: an environment variable is visible in
# `docker inspect`, in /proc/<pid>/environ to anything in the same namespace, and
# in a crash dump.
#
# The file WINS over the variable. If both are set, the file is the deliberate
# configuration and the variable is usually left over from a compose file nobody
# updated -- preferring the variable would make a mounted secret silently
# ineffective. A <NAME>_FILE that cannot be read is a startup failure, not a
# fallback: a broken mount must not degrade to a stale credential.
#
# Applies to: API_KEY, SESSION_SECRET, LLM_API_KEY, MONGODB_URI, OIDC_AUDIENCE.
# API_KEY_FILE=/run/secrets/adaas_api_key
# SESSION_SECRET_FILE=/run/secrets/adaas_session_secret
