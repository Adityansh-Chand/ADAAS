PORT=3000
API_KEY=
MONGODB_URI=
BASE_URL=http://localhost:3000

# Policy retrieval: lexical | dense | hybrid. Default lexical.
#
# Measured on paraphrased questions (npm run eval, Set B report half):
#   lexical  top-1 0.1111   recall@5 0.1111   15 of 18 return nothing
#   dense    top-1 0.6111   recall@5 0.9444    0 of 18 return nothing
#   hybrid   top-1 0.6111   recall@5 0.9444   no better than dense alone
#
# dense and hybrid embed the query at request time, which needs the optional
# @huggingface/transformers devDependency. It is absent from production images
# (npm ci --omit=dev) because its transitive advisories have no fix available,
# so those modes fall back to lexical there and /health reports the degradation.
RETRIEVAL_MODE=

# Where the sentence-transformer weights are cached (~87 MB).
MODEL_CACHE_DIR=

# Optional LLM. With LLM_PROVIDER unset, policy answers come straight from the
# retrieved policy text -- which is the mode this repository is meant to be
# reviewed in. Supported: gemini, openai, anthropic. LLM_BASE_URL lets `openai`
# point at any OpenAI-compatible endpoint (Ollama, vLLM, OpenRouter, ...).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=8000
